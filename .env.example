# Slack Tokens (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # For Socket Mode
SLACK_USER_TOKEN=xoxp-...         # Required for setting user status (users.profile:write scope)
SLACK_USER_ID=U0123456789         # The one Slack user this bot manages

# Google Calendar API
# Option 1: Set JSON content directly as env vars (recommended for containers)
GOOGLE_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...",...}}
GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...",...}
# Option 2: Use file paths (for local development)
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary        # or a specific calendar ID

# Bot Settings
POLL_INTERVAL_SECONDS=60
